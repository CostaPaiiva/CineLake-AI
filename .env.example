# CineLake AI - Environment variables example
# Copie para .env local:
# cp .env.example .env

# Application
CINELAKE_ENV=development
CINELAKE_LOG_LEVEL=INFO

# PostgreSQL (container)
POSTGRES_USER=cinelake
POSTGRES_PASSWORD=cinelake_password
POSTGRES_DB=cinelake
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# TMDb API
TMDB_API_KEY=your_tmdb_api_key_here

# SQLAlchemy connection string (para Alembic e aplicação)
DATABASE_URL=postgresql+psycopg://cinelake:cinelake_password@127.0.0.1:5432/cinelake