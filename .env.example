# CineLake AI - Exemplo de Variáveis de Ambiente
# Para utilizar localmente, copie este arquivo e salve como .env:
# cp .env.example .env

# ==========================================
# Configurações Gerais da Aplicação
# ==========================================
# Ambiente de execução: development (desenvolvimento), production (produção) ou testing (testes)
CINELAKE_ENV=development
# Nível de detalhamento dos logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
CINELAKE_LOG_LEVEL=INFO

# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
# Usuário administrador do banco de dados PostgreSQL
POSTGRES_USER=cinelake
# Senha do usuário do banco de dados PostgreSQL (altere em produção!)
POSTGRES_PASSWORD=cinelake_password
# Nome do banco de dados a ser criado e usado
POSTGRES_DB=cinelake
# Host de conexão (use 'postgres' se estiver no Docker Compose ou '127.0.0.1' para acesso local direto)
POSTGRES_HOST=127.0.0.1
# Porta padrão de escuta do PostgreSQL
POSTGRES_PORT=5432

# ==========================================
# SQLAlchemy - URL de Conexão com o Banco
# ==========================================
# String de conexão usada pela aplicação e pelas migrações do Alembic
DATABASE_URL=postgresql+psycopg://cinelake:cinelake_password@127.0.0.1:5432/cinelake

# ==========================================
# Integração com a API do TMDB (The Movie Database)
# ==========================================
# Sua chave de API obtida no painel de desenvolvedor do TMDB (https://www.themoviedb.org/)
TMDB_API_KEY=sua_chave_aqui

# ==========================================
# Armazenamento de Objetos (MinIO / S3)
# ==========================================
# Chave de acesso (usuário administrador) do MinIO
MINIO_ACCESS_KEY=cinelake_minio
# Chave secreta (senha) do MinIO (altere em produção!)
MINIO_SECRET_KEY=cinelake_minio_secret
# Endereço (IP:Porta) de conexão com a API do MinIO
MINIO_ENDPOINT=127.0.0.1:9000
# Nome do bucket (balde/pasta) onde os arquivos serão armazenados
MINIO_BUCKET=data-lake
# Define se a conexão deve usar protocolo seguro HTTPS (true) ou HTTP comum (false)
MINIO_USE_SSL=false

# ==========================================
# Monitoramento (Grafana)
# ==========================================
# Senha do usuário administrador do Grafana (altere em produção!)
GRAFANA_ADMIN_PASSWORD=admin